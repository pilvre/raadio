# Raadiosalvesti seaded: ~/.config/kuku-salvestus/config.env (install.sh teeb selle ise)

# --- Kus salvestused hoitakse ---
# local = Maci kaust (vaikimisi, pilve pole vaja); r2 = Cloudflare R2
STORAGE=local
LOCAL_DIR=~/Music/Raadiosalvestaja

# --- Kohalik veebileht (STORAGE=local) ---
WEB_PORT=8788
# Parool on soovitatav; ilma selleta pääseb lehele igaüks samas võrgus
WEB_USER=raadio
WEB_PASS=

# --- Cloudflare R2 (STORAGE=r2) ---
# ACCOUNT_ID: Cloudflare → Storage & Databases → R2 Object Storage → Overview (paremal "Account ID")
# Token: R2 Object Storage → Manage API tokens → Create API token (Object Read & Write, ainult see bucket)
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=raadio
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Valikuline: kui Kuku muudab voo või kava aadressi
# KUKU_STREAM_URL=
# KUKU_SCHEDULE_URL=
